# Optional LLM Configuration
LLM_PROVIDER=none # Options: none (deterministic rule engine), openai, anthropic, gemini, ollama
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# RCA Agent Settings
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.7
TIME_WINDOW_MINUTES=30
