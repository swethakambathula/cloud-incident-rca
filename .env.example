# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
INCIDENT_SERVICE=checkout-service
DEFAULT_TIME_WINDOW=10

# Gemini LLM Configuration (Optional: uses Application Default Credentials if empty)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# RCA Agent Investigation Settings
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.70

# Phase 4 Bucket Storage (logs stored in buckets itself)
LOG_BUCKET=your-gcs-bucket-name  # e.g. project-f14fda81-0a51-incident-logs
GCS_BUCKET=  # alias for LOG_BUCKET
MAX_SCALE_LIMIT=20
USE_BIGQUERY=false
INCIDENT_DATASET=incident_memory
